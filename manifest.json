{
  "manifest_version": 3,
  "name": "Post Peek",
  "version": "1.4.0",
  "description": "Read one post and leave. Opens X and Bluesky post links in a popup, not the full site. No account, no cookies sent to either.",
  "homepage_url": "https://timvanbenschoten.com/code/post-peek",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://cdn.syndication.twimg.com/*",
    "https://pbs.twimg.com/*",
    "https://public.api.bsky.app/*",
    "https://cdn.bsky.app/*",
    "https://video.bsky.app/*",
    "https://video.cdn.bsky.app/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://bsky.app/*"
      ],
      "js": ["src/popup-css.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Post Peek",
    "default_popup": "options/options.html"
  }
}
